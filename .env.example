# ─────────────────────────────────────────────────────────
# .env.example  —  copy this file to .env and fill in your real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────

# PostgreSQL connection string (AWS RDS or any compatible DB)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@your-rds-host.rds.amazonaws.com:5432/postgres

# API base URL used by the Streamlit dashboard
# For local dev: http://localhost:8000
# For cloud deployment: http://<your-ec2-ip>:8000
API_URL=http://localhost:8000
